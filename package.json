{
  "name": "software-factory",
  "version": "0.3.0",
  "description": "A small software factory: label a GitHub issue, get back a tested, reviewed pull request.",
  "private": true,
  "type": "module",
  "bin": {
    "factory": "src/cli.mjs"
  },
  "scripts": {
    "factory": "node src/cli.mjs",
    "demo:setup": "node scripts/setup-demo.mjs",
    "demo": "node scripts/setup-demo.mjs && node src/cli.mjs run examples/issues/001-duration-edge-cases.md",
    "poll": "node src/cli.mjs poll",
    "status": "node src/cli.mjs status",
    "metrics": "node src/cli.mjs metrics",
    "dashboard": "node src/cli.mjs dashboard --serve 4700",
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  }
}
