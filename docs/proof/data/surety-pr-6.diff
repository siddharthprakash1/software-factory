diff --git a/src/surety/trace/jsonl.py b/src/surety/trace/jsonl.py
index a458bea..bedabbb 100644
--- a/src/surety/trace/jsonl.py
+++ b/src/surety/trace/jsonl.py
@@ -15,3 +15,9 @@ def record(self, row: dict) -> None:
 
     def close(self) -> None:
         self.f.close()
+
+    def __enter__(self) -> "Trace":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
diff --git a/tests/test_trace.py b/tests/test_trace.py
index da0d203..8db6cc3 100644
--- a/tests/test_trace.py
+++ b/tests/test_trace.py
@@ -10,3 +10,26 @@ def test_two_records_two_lines_with_ts(tmp_path):
     t.close()
     rows = [json.loads(x) for x in (tmp_path / "runs" / "t.jsonl").read_text().splitlines()]
     assert [r["step"] for r in rows] == [0, 1] and all("ts" in r for r in rows)
+
+
+def test_context_manager_writes_row_and_closes_file(tmp_path):
+    path = tmp_path / "runs" / "t.jsonl"
+    with Trace(path) as t:
+        t.record({"x": 1})
+    assert t.f.closed
+    rows = [json.loads(x) for x in path.read_text().splitlines()]
+    assert [r["x"] for r in rows] == [1] and "ts" in rows[0]
+
+
+def test_context_manager_closes_file_and_propagates_exception(tmp_path):
+    path = tmp_path / "t.jsonl"
+    try:
+        with Trace(path) as t:
+            t.record({"x": 1})
+            raise RuntimeError("boom")
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError("exception was swallowed")
+    assert t.f.closed
+    assert len(path.read_text().splitlines()) == 1
