+@pytest.mark.parametrize(
+    "text, expected, abstained",
+    [
+        ("E1", "E1", False),
+        ("E12", "E12", False),
+        ("E1.", "E1", False),
+        ("E12.", "E12", False),
+        ("Answer: (E1), final.", "E1", False),
+        ("NONE, not a1", None, True),
+        ("a1, NONE", None, True),
+        ("-E1", "E1", False),
+        ("E1 -NONE", "E1", False),
+        ("E9", None, False),
+    ],
+)
+def test_choose_parse_cases(httpx_mock, text, expected, abstained):
+    _reply(httpx_mock, text)
+    chosen, usage = _sup().choose(_ids_state())
+    assert chosen == expected and usage.abstained is abstained
+
+
+def test_choose_drops_candidate_not_in_options(httpx_mock):
+    _reply(httpx_mock, "X9")
+    assert _sup().choose(_ids_state(), ["X9", "E1"])[0] is None
+    _reply(httpx_mock, "E1")
+    assert _sup().choose(_ids_state(), ["X9", "E1"])[0] == "E1"
+
+
+def test_choose_propagates_http_error(httpx_mock):
+    httpx_mock.add_response(url="http://sup/v1/chat/completions", status_code=500, json={"error": "boom"})
+    with pytest.raises(httpx.HTTPStatusError):
+        _sup().choose(_state())
+
+
