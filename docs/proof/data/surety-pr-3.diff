     assert m.ece(probs, ["a", "b"]) == pytest.approx(0.4)
 
 
+def test_ece_p_max_of_one_lands_in_last_bin():
+    # conf == 1.0 maps to bin n_bins - 1 (clamp); if it fell outside the bins it would be dropped.
+    assert m.ece([{"a": 1.0, "b": 0.0}], ["b"]) == pytest.approx(1.0)
+    assert m.ece([{"a": 1.0, "b": 0.0}], ["a"]) == pytest.approx(0.0)
+
+
+def test_ece_sums_over_several_non_empty_bins():
+    # bin 14 (conf .95): 2 items, acc .5 -> 0.5 * |0.5 - 0.95| = 0.225
+    # bin 11 (conf .75): 1 item,  acc 1.0 -> 0.25 * |1.0 - 0.75| = 0.0625
+    # bin 8  (conf .55): 1 item,  acc 0.0 -> 0.25 * |0.0 - 0.55| = 0.1375
+    probs = [
+        {"a": 0.95, "b": 0.05},
+        {"a": 0.95, "b": 0.05},
+        {"a": 0.75, "b": 0.25},
+        {"a": 0.55, "b": 0.45},
+    ]
+    assert m.ece(probs, ["a", "b", "a", "b"]) == pytest.approx(0.425)
+
+
